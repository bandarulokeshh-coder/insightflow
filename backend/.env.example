# InsightFlow backend environment
# Copy to .env and fill in.

# --- Adaption (THE differentiator) -------------------------------
# Get a key: https://adaptionlabs.ai/app/settings?tab=api_keys
# If unset, the Refinery runs in DEMO mode (cached artifact) and the
# rest of the app still works end-to-end.
ADAPTION_API_KEY=

# --- Optional LLM for the analysis engine ------------------------
# The analysis engine works fully offline (rule-based). If you set one
# of these, sentiment/topic extraction is upgraded to LLM-quality.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- App ---------------------------------------------------------
DATABASE_URL=sqlite:///./insightflow.db
CORS_ORIGINS=*
